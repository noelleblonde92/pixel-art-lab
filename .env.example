# Copy this to .env and fill in the key:  cp .env.example .env

# Required
OPENROUTER_API_KEY=

# Everything below is optional — leave a line commented out to take its default.
# Do not set a var to an empty value

# Path to the pixel-mcp binary
#PIXEL_MCP_BIN=./pixel-mcp/bin/pixel-mcp

# Backend port
#PORT=8787

#RUNS_DIR=./runs

# Saved benchmark results
#GALLERY_DIR=./gallery

# Prompt caching. On by default, and worth most of the input bill on a long run against a provider
# that caches only where it is told to (Anthropic, Alibaba, Google). Set to 0 to measure the uncached
# baseline — a cached run and an uncached one are not comparable on cost.
#PAL_PROMPT_CACHE=1
